# ------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT CONFIGURATION FOR HARSH PORTFOLIO
# ------------------------------------------------------------------------
# ⚠️ ACTION REQUIRED BEFORE RUNNING PRODUCTION BUILD:
# Copy this file to `.env` and set your live custom domain.
# This URL is used to generate the canonical link, Open Graph tags,
# sitemap.xml references, and Schema.org structured data.
#
# Examples:
#   VITE_SITE_URL=https://harshshandilya.com
#   VITE_SITE_URL=https://harshkumar.dev
# ------------------------------------------------------------------------
VITE_SITE_URL=https://YOUR_DOMAIN_HERE.com

